{
  "manifest_version": 3,
  "name": "Sim Companies Manager",
  "version": "2.5.373",
  "description": "Sim Companies Manager, optimized for mobile: lighter background work, phone layouts, Tools tab and building-card profit.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "debugger",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.simcompanies.com/*",
    "https://simcompanies.com/*",
    "https://api.simcotools.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Sim Companies Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.simcompanies.com/*",
        "https://simcompanies.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.simcompanies.com/*",
        "https://simcompanies.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.simcompanies.com/*",
        "https://simcompanies.com/*"
      ],
      "js": [
        "live-updates.js"
      ],
      "css": [
        "monitor-overlay.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://www.simcompanies.com https://simcompanies.com"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://www.simcompanies.com/*",
        "https://simcompanies.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
